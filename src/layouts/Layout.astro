---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Soy Teo Fassardi, Full Stack Developer y estudiante de Ingeniería en Sistemas. Conocé mis proyectos de desarrollo web y pongámonos en contacto." />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content="Teo Fassardi — Full Stack Developer" />
    <meta property="og:description" content="Portfolio de Teo Fassardi. Proyectos de desarrollo web, tecnologías y contacto." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta name="author" content="Teo Fassardi" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Teo Fassardi — Full Stack Developer</title>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('portfolio-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#101010' : '#faf9f6');
      })();
    </script>
  </head>
  <body><slot /></body>
</html>
